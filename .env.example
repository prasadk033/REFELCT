# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://your-server-ip:5173,http://localhost:5173

# Redis (agent/workflow state)
# For remote instance development via SSH tunnel: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# LLM — Qwen via LiteLLM proxy
LLM_PROVIDER=litellm
LLM_MODEL=qwen
QWEN_API_KEY=your-qwen-api-key-here

# LiteLLM Proxy
# For remote instance development via SSH tunnel: http://localhost:4000
LITELLM_API_BASE=http://localhost:4000
LITELLM_MASTER_KEY=your-litellm-master-key-here

# PostgreSQL — LiteLLM persistence
# For remote instance development via SSH tunnel: postgresql://litellm:your-litellm-db-password@localhost:5432/litellm
DATABASE_URL=postgresql://litellm:your-litellm-db-password@localhost:5432/litellm

# PostgreSQL — Reflect Application database
# For remote instance development via SSH tunnel: postgresql://reflect:your-reflect-db-password@localhost:5432/reflect
APP_DATABASE_URL=postgresql://reflect:your-reflect-db-password@localhost:5432/reflect

# App Settings
MAX_AGENT_RETRIES=3

# JWT Secret — change this in production!
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TurboOCR — GPU 3
# Connect via SSH tunnel: ssh -L 8005:10.10.10.2:8005 <username>@152.228.229.140
TURBOOCR_API_URL=http://localhost:8005
TURBOOCR_API_KEY=your-turboocr-api-key

# Storage type: local or s3
STORAGE_TYPE=s3

# MinIO (S3-compatible object storage)
# For remote instance development via SSH tunnel: http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=reflect-uploads
MINIO_SECURE=false
