# Server
HOST=0.0.0.0
PORT=8000

# CORS — React dev server origin
CORS_ORIGINS=http://152.228.229.140:5173

# Redis (agent/workflow state)
REDIS_URL=redis://redis:6379

# LLM
LLM_PROVIDER=litellm
LLM_MODEL=qwen
QWEN_API_KEY=your_qwen_api_key_here

# LiteLLM Proxy
LITELLM_API_BASE=http://litellm:4000
LITELLM_MASTER_KEY=your_litellm_master_key_here

# PostgreSQL (LiteLLM persistence only)
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/litellm

# App Settings
MAX_AGENT_RETRIES=3
