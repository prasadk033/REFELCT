# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://your-server-ip:5173,http://localhost:5173

# Redis (agent/workflow state)
# For remote instance development via SSH tunnel: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# LLM — Qwen via LiteLLM proxy
LLM_PROVIDER=litellm
LLM_MODEL=qwen
QWEN_API_KEY=your-qwen-api-key-here

# LiteLLM Proxy
# For remote instance development via SSH tunnel: http://localhost:4000
LITELLM_API_BASE=http://localhost:4000
LITELLM_MASTER_KEY=your-litellm-master-key-here

# PostgreSQL Database Credentials
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=your-secure-postgres-password
REFLECT_DB_USER=reflect
REFLECT_DB_PASSWORD=your-secure-reflect-password
REFLECT_DB_NAME=reflect

# PostgreSQL — LiteLLM persistence
# Inside Docker: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://litellm:your-secure-postgres-password@localhost:5432/litellm

# PostgreSQL — Reflect Application database
# Inside Docker: postgresql://${REFLECT_DB_USER}:${REFLECT_DB_PASSWORD}@postgres:5432/${REFLECT_DB_NAME}
APP_DATABASE_URL=postgresql://reflect:your-secure-reflect-password@localhost:5432/reflect

# Worker Queue Configuration: distributed (Redis RQ) or inprocess (FastAPI background)
WORKER_MODE=distributed

# App Settings
MAX_AGENT_RETRIES=3

# JWT Secret — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-random-secret-key-here

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TurboOCR — GPU 3
# Connect via SSH tunnel: ssh -L 8005:10.10.10.2:8005 <username>@152.228.229.140
TURBOOCR_API_URL=http://localhost:8005
TURBOOCR_API_KEY=your-turboocr-api-key

# Storage type: local or s3
STORAGE_TYPE=s3

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=your-minio-admin-user
MINIO_ROOT_PASSWORD=your-minio-admin-password
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=reflect-uploads
MINIO_SECURE=false

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@reflect.local
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
