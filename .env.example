# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://your-server-ip:5173,http://localhost:5173

# Redis (agent/workflow state)
REDIS_URL=redis://redis:6379

# LLM — Qwen via LiteLLM proxy
LLM_PROVIDER=litellm
LLM_MODEL=qwen
QWEN_API_KEY=your-qwen-api-key-here

# LiteLLM Proxy
LITELLM_API_BASE=http://litellm:4000
LITELLM_MASTER_KEY=your-litellm-master-key-here

# PostgreSQL — LiteLLM persistence
DATABASE_URL=postgresql://litellm:your-litellm-db-password@postgres:5432/litellm

# PostgreSQL — Reflect Application database
APP_DATABASE_URL=postgresql://reflect:your-reflect-db-password@postgres:5432/reflect

# App Settings
MAX_AGENT_RETRIES=3

# JWT Secret — change this in production!
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TurboOCR — GPU 3
# Private cluster IP (preferred): http://10.10.10.2:8005
# Public IP (fallback):           http://115.244.46.68:8005
TURBOOCR_API_URL=http://10.10.10.2:8005
TURBOOCR_API_KEY=

# Storage type: local or s3
STORAGE_TYPE=s3

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=reflect-uploads
MINIO_SECURE=false
